# Verdigris - optional configuration.  Copy to .env for local experiments, or set
# these in the Render dashboard.  EVERY value here is optional: with an empty file
# the app still runs, and sources that need a key are reported honestly as
# "Not checked" instead of being faked or silently skipped.
#
# Never commit a filled-in copy: .gitignore excludes .env and .env.* (this file is
# the only one kept).

# --- runtime ---------------------------------------------------------------
PORT=8080                     # Render injects its own PORT; the app honours it
REQUEST_LOG=1                 # logs "METHOD /path" only - never query strings
TRUST_PROXY_HEADERS=1         # trust the first X-Forwarded-For hop for rate limits
SOURCE_DEBUG=0                # 1 = include exception detail in "Unavailable" messages
                              #     (useful while debugging, leave 0 in public deploys)

# --- access control --------------------------------------------------------
# Empty = the API is open to anyone who has the URL (the UI says so before you scan).
# Set it to require X-Access-Token / "Authorization: Bearer <token>" on every /api/*
# call.  /health and the static UI stay open so the token can be entered in Settings.
ACCESS_TOKEN=

# --- optional upstream keys (users may also supply their own per request) ----
HIBP_API_KEY=                 # paid HIBP API v3 key: email breach + paste lookups (~US$3.95/mo, ~10 req/min per key)
VIRUSTOTAL_API_KEY=           # free VT key: domain detection counts
ABUSECH_AUTH_KEY=             # free abuse.ch Auth-Key: full URLhaus host history
GITHUB_TOKEN=                 # raises GitHub rate limits (helps a shared-IP deploy)

# --- source selection ------------------------------------------------------
# Comma-separated source ids to turn off (see /api/meta for the list).  Disabled
# sources are shown as disabled; they are never reported as "no match".
DISABLED_SOURCES=

# Comma-separated https JSON-RPC endpoints for Ethereum, tried in order.
# Leave empty to use the built-in keyless list (publicnode, llamarpc, Cloudflare,
# nodeflare, 1rpc, drpc).
ETH_RPC_URLS=

# --- rate limits (per client IP, per minute) -------------------------------
RATE_SCAN_PER_MIN=12
RATE_API_PER_MIN=60
RATE_PASSWORD_PER_MIN=10
